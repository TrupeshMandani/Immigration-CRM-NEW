# Backend API — must match apps/backend PORT
VITE_API_URL=http://localhost:4000/api

# Backend origin (used for Socket.IO connection)
VITE_BACKEND_URL=http://localhost:4000

# MCP AI agent server
VITE_MCP_URL=http://localhost:3002/api/chat

# Firebase Web SDK — get values from Firebase console > Project settings > Your apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
