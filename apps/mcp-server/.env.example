PORT=3002

# Backend API base URL (no trailing slash)
BACKEND_URL=http://localhost:4000/api

# Service-to-service token — must match BACKEND_SERVICE_TOKEN on the backend
BACKEND_SERVICE_TOKEN=change-me-in-production

# OpenAI
OPENAI_API_KEY=

# SMTP (used by email tools)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
