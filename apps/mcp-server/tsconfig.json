{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "./dist",
    "resolveJsonModule": true,
    "paths": {
      "@icrm/shared-types/*": ["../../packages/shared-types/*"]
    }
  },
  "include": ["./**/*.ts", "./**/*.js"],
  "exclude": ["node_modules", "dist"]
}
