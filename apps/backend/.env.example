PORT=4000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/ImmigrationCRM

# Redis (used by BullMQ document-hashing queue — started by docker-compose.dev.yml)
REDIS_URL=redis://localhost:6379

# PostgreSQL (Drizzle)
DATABASE_URL=postgresql://icrm:icrm_dev@localhost:5433/icrm_dev

# Multi-tenancy — run seed-default-firm.ts and paste the UUID here
DEFAULT_FIRM_ID=

# JWT — access token 15m, refresh token 7d
JWT_ACCESS_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-in-production-different-from-access
# Legacy fallback (used by older tokens until they expire)
JWT_SECRET=change-me-in-production

# OpenAI
OPENAI_API_KEY=

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

APP_BASE_URL=http://localhost:5173
ADMIN_NOTIFICATIONS_EMAIL=

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=
S3_PRESIGNED_URL_EXPIRY=3600

# Firebase
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Google
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Stripe (test mode — replace with live keys for production)
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_CONNECT_CLIENT_ID=ca_your_connect_client_id_here
