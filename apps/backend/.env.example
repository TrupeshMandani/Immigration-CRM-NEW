PORT=4000
NODE_ENV=development

# PostgreSQL (Drizzle ORM) — start with: docker-compose -f docker-compose.dev.yml up -d
DATABASE_URL=postgresql://icrm:icrm_dev@localhost:5433/icrm_dev

# Multi-tenancy — run seed-default-firm.ts and paste the UUID here
DEFAULT_FIRM_ID=

# Redis (used by BullMQ workers — started by docker-compose.dev.yml)
REDIS_URL=redis://localhost:6379

# JWT — access token 15m, refresh token 7d
JWT_ACCESS_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-in-production-different-from-access
JWT_SECRET=change-me-in-production

# AI providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# MCP agent server
MCP_SERVER_URL=http://localhost:3002/api/chat

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
ADMIN_NOTIFICATIONS_EMAIL=

# App
APP_BASE_URL=http://localhost:5173

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=
S3_PRESIGNED_URL_EXPIRY=3600

# Firebase Admin SDK
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Optional: only needed if using Firebase Dynamic Links in invite emails
FIREBASE_DYNAMIC_LINK_DOMAIN=

# Stripe (test mode — replace with live keys for production)
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_CONNECT_CLIENT_ID=ca_your_connect_client_id_here
