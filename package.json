{
  "name": "@icrm/root",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:backend": "pnpm --filter @icrm/backend dev",
    "dev:frontend": "pnpm --filter @icrm/consultant-web dev",
    "dev:mcp": "pnpm --filter @icrm/mcp-server dev",
    "dev:db": "pnpm --filter @icrm/backend db:studio",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "docker:dev": "docker compose -f docker-compose.dev.yml up -d",
    "docker:down": "docker compose -f docker-compose.dev.yml down"
  },
  "devDependencies": {
    "playwright": "^1.61.1"
  }
}